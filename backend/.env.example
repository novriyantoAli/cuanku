# Reference of the variables the API reads. It is not a file to copy into place:
# the Go app reads the *process environment* (plus an optional YAML file named by
# CONFIG_FILE) and deliberately does not load .env files, so export these in your
# shell, use direnv, or let your process manager inject them.
#
#   export DATABASE_URL='postgres://<user>:<password>@<vm-address>:5432/<database>?sslmode=disable'
#   make run
#
# The dev PostgreSQL lives in the VirtualBox VM (see AGENTS.md). Its address is
# DHCP-assigned, so no address is written down here — look it up.

# Required. There is no default anywhere in the codebase: boot fails with a
# message naming this variable when it is unset (see internal/config/config.go).
DATABASE_URL=

# HTTP server
PORT=8080
SERVER_HOST=0.0.0.0

# development | production
APP_ENV=development
APP_NAME=cuanku-api
APP_VERSION=0.1.0

# debug | info | warn | error
LOGGER_LEVEL=info

# Comma-separated browser origins allowed to call the API. The SvelteKit app
# proxies through its own /api/** routes, so this only matters for other callers.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional YAML config file; env vars above always win over it.
# CONFIG_FILE=config.yaml
