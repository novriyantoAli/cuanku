# Copy to .env and fill in. Never commit the real .env (see ../.gitignore).

# ---------------------------------------------------------------------------
# Server-only. Read by the +server.ts proxy routes (Pattern A in the frontend
# skill): the browser never sees these.
# ---------------------------------------------------------------------------

# Base URL of the Go API. The dev API listens on :8080 by default.
BACKEND_URL=http://127.0.0.1:8080

# Timeout for the server-side hop to the Go API, in milliseconds.
BACKEND_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Client-exposed. Only PUBLIC_-prefixed variables reach the browser.
# ---------------------------------------------------------------------------

# Base URL the browser calls. Leave as /api to use this app's own same-origin
# proxy routes.
PUBLIC_API_BASE_URL=/api

# How often the status card re-checks the backend, in milliseconds.
PUBLIC_HEALTH_POLL_MS=30000
